{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.openacademy.example",
    "Audience": "https://openacademy.example",
    "Algorithm": "HS256",
    "ExpiryInMinutes": 5,
    "CookieName": "AccessToken"
  },
  "RefreshToken": {
    "CookieName": "RefreshToken",
    "ShortExpiryInMinutes": 15,
    "LongExpiryInMinutes": 10080
  },
  "Csrf": { "CookieName": "__Host-csrf" },
  "S3": { "Region": "us-east-1", "ForcePathStyle": true },
  "Database": { "CommandTimeoutSeconds": 30 }
}
