# OpenAcademy local-test environment
# Copy to .env. These values are examples only: keys, passwords, and S3 credentials
# are randomly generated placeholders and will not authenticate to real services.
# Never use these values in production or commit your populated .env file.
# Configuration keys use Section__Key (double underscore = ':' in .NET configuration).

ASPNETCORE_ENVIRONMENT=Development

# --- JWT access tokens ---
# HS256 requires a signing key of at least 32 UTF-8 bytes.
Jwt__SigningKey=b559ee6e50a0030f8ad27cd90a324ead82ccfd64542aa6b7d1b44d24e1bb5540
Jwt__Issuer=https://api.openacademy.test
Jwt__Audience=https://app.openacademy.test
Jwt__Algorithm=HS256
Jwt__ExpiryInMinutes=5
Jwt__ClockSkewInSeconds=30
Jwt__CookieName=AccessToken

# --- Refresh tokens ---
# Must be at least 32 characters and differ from the JWT signing key.
RefreshToken__SigningKey=80ca657fde7f397e129b988a77bcee33c298da7f9525ef7889f55ce28c59270f
RefreshToken__CookieName=RefreshToken
RefreshToken__ShortExpiryInMinutes=15
RefreshToken__LongExpiryInMinutes=10080

# --- CSRF ---
# __Host- cookies require HTTPS, Path=/, and no Domain attribute.
Csrf__CookieName=__Host-csrf

# --- Frontend / CORS ---
# Use a bare origin with no path or trailing slash.
Frontend__Origin=https://app.openacademy.test

# --- PostgreSQL ---
# Local development database; provision it separately before running the API.
Database__ConnectionString=Host=localhost;Port=5432;Database=openacademy_dev;Username=openacademy_dev;Password=0eecd31ed56d88f9fdf7273f2cf3a65e
Database__CommandTimeoutInSeconds=30
Database__MaxRetryCount=5
Database__MaxRetryDelayInSeconds=15

# --- S3-compatible storage ---
# Test credentials are random and intentionally invalid for any real S3 account.
# Replace the endpoint and create both distinct buckets in your local S3-compatible service.
S3__Endpoint=http://localhost:8333
S3__PublicEndpoint=http://localhost:8333
S3__Region=us-east-1
S3__AccessKey=AKIAB3C1D9A72B0DE32E
S3__SecretAccessKey=MWeLA9Ez60NcIfe1TwkexeoyhCw1Q76d8jad3LM8
S3__BucketName=openacademy-private-test-7a91
S3__PublicBucketName=openacademy-public-test-4c28
S3__ForcePathStyle=true

# --- Key protection certificate ---
# These paths are relative to the API's working directory. Supply a matching
# certificate/private key pair before startup; never commit production keys.
KeyProtection__CertificatePath=./.secrets/dp.crt
KeyProtection__PrivateKeyPath=./.secrets/dp.key
# Optional directory containing retired certificate/key pairs for decrypting old data.
# KeyProtection__RetiredDirectory=./.secrets/retired

# --- SMTP email ---
# Mailpit/MailHog local SMTP defaults; no authentication or TLS.
SmtpEmail__Host=localhost
SmtpEmail__Port=1025
SmtpEmail__FromAddress=noreply@openacademy.test
SmtpEmail__FromName=OpenAcademy Local
SmtpEmail__SecurityMode=None
# Set both when your local SMTP service requires authentication.
# SmtpEmail__Username=
# SmtpEmail__Password=

# --- Media processing ---
# ffmpeg and ffprobe must be installed and available on PATH.
Media__MaxImageMegabytes=5
Media__MaxImageMegapixels=40
Media__ImageMaxDimension=1920
Media__WebpQuality=80
Media__MaxPublicImageMegabytes=2
Media__PublicImageMaxDimension=512
Media__MaxVideoMegabytes=100
Media__MaxVideoDurationSeconds=900
Media__VideoMaxHeight=720
Media__VideoCrf=28
Media__VideoPreset=veryfast
Media__TranscodeTimeoutSeconds=300
Media__PresignedUrlLifetimeMinutes=60
Media__FfmpegPath=ffmpeg
Media__FfprobePath=ffprobe
