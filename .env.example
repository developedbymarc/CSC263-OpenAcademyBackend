# OpenAcademy.Api environment variables
# Format: Section__Key (double underscore = ':' in configuration keys; case-insensitive).
# Copy to .env (chmod 600), never commit the real file.
# Required = no default; startup fails if missing.

# --- Jwt (access token) ---
# Required. >= 32 bytes for HS256, 48 for HS384, 64 for HS512. Randomly generate with: openssl rand -base64 <length>
Jwt__SigningKey=
Jwt__Issuer=https://api.openacademy.example
Jwt__Audience=https://openacademy.example
# HS256 | HS384 | HS512
Jwt__Algorithm=HS256
Jwt__ExpiryInMinutes=5
Jwt__CookieName=AccessToken

# --- RefreshToken ---
# Required. >= 32 chars and different from Jwt__SigningKey
RefreshToken__SigningKey=
RefreshToken__CookieName=RefreshToken
# Short must be <= Long.
RefreshToken__ShortExpiryInMinutes=15
RefreshToken__LongExpiryInMinutes=10080

# --- Csrf ---
# Must start with __Host-
Csrf__CookieName=__Host-csrf

# --- Frontend (CORS) ---
# Required. Bare origin: no path, no trailing slash
Frontend__Origin=

# --- Database ---
# Required. Npgsql connection string
Database__ConnectionString=
Database__CommandTimeoutSeconds=30

# --- S3 ---
# Required: Endpoint, AccessKey, SecretAccessKey, BucketName
S3__Endpoint=https://s3.us-east-1.amazonaws.com
S3__Region=us-east-1
S3__AccessKey=
S3__SecretAccessKey=
S3__BucketName=
# true for SeaweedFS and similar
S3__ForcePathStyle=true

# --- Key Protection Certificate ---
# Both required
KeyProtection__CertificatePath=
KeyProtection__PrivateKeyPath=
